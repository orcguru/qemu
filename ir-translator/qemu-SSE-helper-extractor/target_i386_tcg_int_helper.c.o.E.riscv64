static inline _Bool is_mmu_index_user(int mmu_index)
{
    return (mmu_index & ~1) == 2;
}

static inline _Bool is_mmu_index_32(int mmu_index)
{
    ((void) sizeof ((mmu_index < 6) ? 1 : 0), __extension__ ({ if (mmu_index < 6) ; else __assert_fail ("mmu_index < MMU_PHYS_IDX", "../../Github/qemu-runtime/target/i386/cpu.h", 2652, __extension__ __PRETTY_FUNCTION__); }));
    return mmu_index & 1;
}






