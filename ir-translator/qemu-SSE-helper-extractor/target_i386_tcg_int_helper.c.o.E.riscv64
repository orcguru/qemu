static inline gpointer g_steal_pointer (gpointer pp);


static inline gpointer
g_steal_pointer (gpointer pp)
{
  gpointer *ptr = (gpointer *) pp;
  gpointer ref;

  ref = *ptr;
  *ptr = ((void*)0);

  return ref;
}
