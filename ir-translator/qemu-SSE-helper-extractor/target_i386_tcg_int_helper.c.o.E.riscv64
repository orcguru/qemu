    unsigned long *p = addr + ((nr) / (sizeof (unsigned long) * 8));

    *p |= mask;
}






static inline void set_bit_atomic(long nr, unsigned long *addr)
{
    unsigned long mask = (1UL << ((nr) % (sizeof (unsigned long) * 8)));
    unsigned long *p = addr + ((nr) / (sizeof (unsigned long) * 8));

    ((void) __atomic_fetch_or(p, mask, 5));
