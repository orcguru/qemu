extern int use_rt_clock;

static inline int64_t get_clock(void)
{
    if (use_rt_clock) {
        struct timespec ts;
        clock_gettime(1, &ts);
        return ts.tv_sec * 1000000000LL + ts.tv_nsec;
    } else {


        return get_clock_realtime();
    }
}
