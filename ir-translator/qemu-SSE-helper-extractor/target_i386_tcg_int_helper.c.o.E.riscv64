static inline _Bool cpu_breakpoint_test(CPUState *cpu, vaddr pc, int mask)
{
    CPUBreakpoint *bp;

    if (__builtin_expect(!!(!((&cpu->breakpoints)->tqh_first == ((void*)0))), 0)) {
        for ((bp) = ((&cpu->breakpoints)->tqh_first); (bp); (bp) = ((bp)->entry.tqe_next)) {
            if (bp->pc == pc && (bp->flags & mask)) {
                return 1;
            }
        }
    }
    return 0;
}
