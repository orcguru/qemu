static inline MemOp size_memop(unsigned size)
{


    ((void) sizeof ((is_power_of_2(size) && size >= 1 && size <= (1 << MO_SIZE)) ? 1 : 0), __extension__ ({ if (is_power_of_2(size) && size >= 1 && size <= (1 << MO_SIZE)) ; else __assert_fail ("is_power_of_2(size) && size >= 1 && size <= (1 << MO_SIZE)", "/home/felix/Github/qemu-runtime/include/exec/memop.h", 166, __extension__ __PRETTY_FUNCTION__); }));

