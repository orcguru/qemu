    char *memdev;
    _Bool has_initiator;
    uint16_t initiator;
};

struct NumaDistOptions {
    uint16_t src;
    uint16_t dst;
    uint8_t val;
};

struct NumaCpuOptions {

    _Bool has_node_id;
    int64_t node_id;
    _Bool has_drawer_id;
    int64_t drawer_id;
    _Bool has_book_id;
    int64_t book_id;
    _Bool has_socket_id;
    int64_t socket_id;
    _Bool has_die_id;
    int64_t die_id;
    _Bool has_cluster_id;
    int64_t cluster_id;
    _Bool has_module_id;
    int64_t module_id;
    _Bool has_core_id;
    int64_t core_id;
    _Bool has_thread_id;
    int64_t thread_id;

};

