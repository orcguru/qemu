target_ulong helper_aam(target_ulong al, target_ulong base)
{
    int ah;

    al &= 0xff;
    ah = al / base;
    al = al % base;
    return al | (ah << 8);
}

target_ulong helper_aad(target_ulong ax, target_ulong base)
{
    int al, ah;

    al = ax & 0xff;
    ah = (ax >> 8) & 0xff;
    al = ((ah * base) + al) & 0xff;
    return al;
}

void helper_aaa(CPUX86State *env)
{
    int icarry;
    int al, ah, af;
    int eflags;

    eflags = cpu_cc_compute_all(env);
    af = eflags & 0x0010;
    al = env->regs[R_EAX] & 0xff;
    ah = (env->regs[R_EAX] >> 8) & 0xff;

    icarry = (al > 0xf9);
    if (((al & 0x0f) > 9) || af) {
        al = (al + 6) & 0x0f;
        ah = (ah + 1 + icarry) & 0xff;
        eflags |= 0x0001 | 0x0010;
    } else {
        eflags &= ~(0x0001 | 0x0010);
        al &= 0x0f;
    }
    env->regs[R_EAX] = (env->regs[R_EAX] & ~0xffff) | al | (ah << 8);
    (env->cc_src) = eflags;
    (env->cc_op) = CC_OP_EFLAGS;
}

void helper_aas(CPUX86State *env)
{
    int icarry;
    int al, ah, af;
    int eflags;

    eflags = cpu_cc_compute_all(env);
    af = eflags & 0x0010;
    al = env->regs[R_EAX] & 0xff;
    ah = (env->regs[R_EAX] >> 8) & 0xff;

    icarry = (al < 6);
    if (((al & 0x0f) > 9) || af) {
        al = (al - 6) & 0x0f;
        ah = (ah - 1 - icarry) & 0xff;
        eflags |= 0x0001 | 0x0010;
    } else {
        eflags &= ~(0x0001 | 0x0010);
        al &= 0x0f;
    }
    env->regs[R_EAX] = (env->regs[R_EAX] & ~0xffff) | al | (ah << 8);
    (env->cc_src) = eflags;
    (env->cc_op) = CC_OP_EFLAGS;
}

void helper_daa(CPUX86State *env)
{
    int old_al, al, af, cf;
    int eflags;

    eflags = cpu_cc_compute_all(env);
    cf = eflags & 0x0001;
    af = eflags & 0x0010;
    old_al = al = env->regs[R_EAX] & 0xff;

    eflags = 0;
    if (((al & 0x0f) > 9) || af) {
        al = (al + 6) & 0xff;
        eflags |= 0x0010;
    }
    if ((old_al > 0x99) || cf) {
        al = (al + 0x60) & 0xff;
        eflags |= 0x0001;
    }
    env->regs[R_EAX] = (env->regs[R_EAX] & ~0xff) | al;

    eflags |= (al == 0) << 6;
    eflags |= compute_pf(al);
    eflags |= (al & 0x80);
    (env->cc_src) = eflags;
    (env->cc_op) = CC_OP_EFLAGS;
}

void helper_das(CPUX86State *env)
{
    int al, al1, af, cf;
    int eflags;

    eflags = cpu_cc_compute_all(env);
    cf = eflags & 0x0001;
    af = eflags & 0x0010;
    al = env->regs[R_EAX] & 0xff;

    eflags = 0;
    al1 = al;
    if (((al & 0x0f) > 9) || af) {
        eflags |= 0x0010;
        if (al < 6 || cf) {
            eflags |= 0x0001;
        }
        al = (al - 6) & 0xff;
    }
    if ((al1 > 0x99) || cf) {
        al = (al - 0x60) & 0xff;
        eflags |= 0x0001;
    }
    env->regs[R_EAX] = (env->regs[R_EAX] & ~0xff) | al;

    eflags |= (al == 0) << 6;
    eflags |= compute_pf(al);
    eflags |= (al & 0x80);
    (env->cc_src) = eflags;
    (env->cc_op) = CC_OP_EFLAGS;
}


static void add128(uint64_t *plow, uint64_t *phigh, uint64_t a, uint64_t b)
{
    *plow += a;

    if (*plow < a) {
        (*phigh)++;
    }
    *phigh += b;
}

static void neg128(uint64_t *plow, uint64_t *phigh)
{
    *plow = ~*plow;
    *phigh = ~*phigh;
    add128(plow, phigh, 1, 0);
}


static int div64(uint64_t *plow, uint64_t *phigh, uint64_t b)
{
    uint64_t q, r, a1, a0;
    int i, qb, ab;

    a0 = *plow;
    a1 = *phigh;
    if (a1 == 0) {
        q = a0 / b;
        r = a0 % b;
        *plow = q;
        *phigh = r;
    } else {
        if (a1 >= b) {
            return 1;
        }

        for (i = 0; i < 64; i++) {
            ab = a1 >> 63;
            a1 = (a1 << 1) | (a0 >> 63);
            if (ab || a1 >= b) {
                a1 -= b;
                qb = 1;
            } else {
                qb = 0;
            }
            a0 = (a0 << 1) | qb;
        }





        *plow = a0;
        *phigh = a1;
    }
    return 0;
}


static int idiv64(uint64_t *plow, uint64_t *phigh, int64_t b)
{
    int sa, sb;

    sa = ((int64_t)*phigh < 0);
    if (sa) {
        neg128(plow, phigh);
    }
    sb = (b < 0);
    if (sb) {
        b = -b;
    }
    if (div64(plow, phigh, b) != 0) {
        return 1;
    }
    if (sa ^ sb) {
        if (*plow > (1ULL << 63)) {
            return 1;
        }
        *plow = -*plow;
    } else {
        if (*plow >= (1ULL << 63)) {
            return 1;
        }
    }
    if (sa) {
        *phigh = -*phigh;
    }
    return 0;
}

void helper_divq_EAX(CPUX86State *env, target_ulong t0)
{
    uint64_t r0, r1;

    if (t0 == 0) {
        raise_exception_ra(env, 0, ((uintptr_t)__builtin_extract_return_addr(__builtin_return_address(0))));
    }
    r0 = env->regs[R_EAX];
    r1 = env->regs[R_EDX];
    if (div64(&r0, &r1, t0)) {
        raise_exception_ra(env, 0, ((uintptr_t)__builtin_extract_return_addr(__builtin_return_address(0))));
    }
    env->regs[R_EAX] = r0;
    env->regs[R_EDX] = r1;
}

void helper_idivq_EAX(CPUX86State *env, target_ulong t0)
{
    uint64_t r0, r1;

    if (t0 == 0) {
        raise_exception_ra(env, 0, ((uintptr_t)__builtin_extract_return_addr(__builtin_return_address(0))));
    }
    r0 = env->regs[R_EAX];
    r1 = env->regs[R_EDX];
    if (idiv64(&r0, &r1, t0)) {
        raise_exception_ra(env, 0, ((uintptr_t)__builtin_extract_return_addr(__builtin_return_address(0))));
    }
    env->regs[R_EAX] = r0;
    env->regs[R_EDX] = r1;
}
# 408 "../../Github/qemu-runtime/target/i386/tcg/int_helper.c"
target_ulong helper_pdep(target_ulong src, target_ulong mask)
{
    target_ulong dest = 0;
    int i, o;

    for (i = 0; mask != 0; i++) {
        o = ctz64(mask);
        mask &= mask - 1;
        dest |= ((src >> i) & 1) << o;
    }
    return dest;
}

target_ulong helper_pext(target_ulong src, target_ulong mask)
{
    target_ulong dest = 0;
    int i, o;

    for (o = 0; mask != 0; o++) {
        i = ctz64(mask);
        mask &= mask - 1;
        dest |= ((src >> i) & 1) << o;
    }
    return dest;
}




void helper_cr4_testbit(CPUX86State *env, uint32_t bit)
{
    if (__builtin_expect(!!((env->cr[4] & bit) == 0), 0)) {
        raise_exception_ra(env, 6, ((uintptr_t)__builtin_extract_return_addr(__builtin_return_address(0))));
    }
}

target_ulong helper_rdrand(CPUX86State *env)
{
    Error *err = ((void*)0);
    target_ulong ret;

    if (qemu_guest_getrandom(&ret, sizeof(ret), &err) < 0) {
        do { if (__builtin_expect(!!(qemu_loglevel_mask((1 << 10))), 0)) { qemu_log("rdrand: Crypto failure: %s", error_get_pretty(err)); } } while (0);

        error_free(err);

        env->cc_src = 0;
        ret = 0;
    } else {

        env->cc_src = 0x0001;
    }
    env->cc_op = CC_OP_EFLAGS;
    return ret;
}
