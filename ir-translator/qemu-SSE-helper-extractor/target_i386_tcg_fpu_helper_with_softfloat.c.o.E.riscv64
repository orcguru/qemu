target_ulong helper_crc32(uint32_t crc1, target_ulong msg, uint32_t len)
{
    target_ulong crc = (msg & ((target_ulong) -1 >>
                               (64 - len))) ^ crc1;

    while (len--) {
        crc = (crc >> 1) ^ ((crc & 1) ? 0x82f63b78 : 0);
    }

    return crc;
}



void helper_pclmulqdq_xmm(CPUX86State *env, ZMMReg *d, ZMMReg *v, ZMMReg *s,
                                    uint32_t ctrl)
{
    int a_idx = (ctrl & 1) != 0;
    int b_idx = (ctrl & 16) != 0;

    for (int i = 0; i < 1; i++) {
        uint64_t a = v->_q_ZMMReg[2 * i + a_idx];
        uint64_t b = s->_q_ZMMReg[2 * i + b_idx];
        Int128 *r = (Int128 *)&d->_x_ZMMReg[i];

        *r = clmul_64(a, b);
    }
}

