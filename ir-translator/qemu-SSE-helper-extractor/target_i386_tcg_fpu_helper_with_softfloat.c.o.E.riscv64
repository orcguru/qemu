static inline uint64_t cr4_reserved_bits(CPUX86State *env)
{
    uint64_t reserved_bits = (~(target_ulong)((1U << 0) | (1U << 1) | (1U << 2) | (1U << 3) | (1U << 4) | (1U << 5) | (1U << 6) | (1U << 7) | (1U << 8) | (1U << 9) | (1U << 10) | (1U << 11) | (1U << 12) | (1U << 16) | (1U << 17) | (1U << 18) | (1U << 20) | (1U << 21) | (1U << 22) | (1U << 24) | (1U << 28) | (1ULL << 32)));
    if (!env->features[FEAT_XSAVE]) {
        reserved_bits |= (1U << 18);
    }
    if (!(env->features[FEAT_7_0_EBX] & (1U << 7))) {
        reserved_bits |= (1U << 20);
    }
    if (!(env->features[FEAT_7_0_EBX] & (1U << 20))) {
        reserved_bits |= (1U << 21);
    }
    if (!(env->features[FEAT_7_0_EBX] & (1U << 0))) {
        reserved_bits |= (1U << 16);
    }
    if (!(env->features[FEAT_7_0_ECX] & (1U << 3))) {
        reserved_bits |= (1U << 22);
    }
    if (!(env->features[FEAT_7_0_ECX] & (1U << 16))) {
        reserved_bits |= (1U << 12);
    }
    if (!(env->features[FEAT_7_0_ECX] & (1U << 2))) {
        reserved_bits |= (1U << 11);
    }
    if (!(env->features[FEAT_7_0_ECX] & (1U << 31))) {
        reserved_bits |= (1U << 24);
    }
    if (!(env->features[FEAT_7_1_EAX] & (1U << 26))) {
        reserved_bits |= (1U << 28);
    }
    if (!(env->features[FEAT_7_1_EAX] & (1U << 17))) {
        reserved_bits |= (1ULL << 32);
    }
    return reserved_bits;
}

static inline _Bool ctl_has_irq(CPUX86State *env)
{
    uint32_t int_prio;
    uint32_t tpr;

    int_prio = (env->int_ctl & (0x0f << 16)) >> 16;
    tpr = env->int_ctl & 0x0f;

    if (env->int_ctl & (1 << 20)) {
        return (env->int_ctl & (1 << 8));
    }

    return (env->int_ctl & (1 << 8)) && (int_prio >= tpr);
}
