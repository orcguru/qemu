static inline uint64_t helper_extrq(uint64_t src, int shift, int len)
{
    uint64_t mask;

    if (len == 0) {
        mask = ~0LL;
    } else {
        mask = (1ULL << len) - 1;
    }
    return (src >> shift) & mask;
}

void helper_extrq_r(CPUX86State *env, ZMMReg *d, ZMMReg *s)
{
    d->_q_ZMMReg[0] = helper_extrq(d->_q_ZMMReg[0], s->_b_ZMMReg[1] & 63, s->_b_ZMMReg[0] & 63);
}

void helper_extrq_i(CPUX86State *env, ZMMReg *d, int index, int length)
{
    d->_q_ZMMReg[0] = helper_extrq(d->_q_ZMMReg[0], index, length);
}

static inline uint64_t helper_insertq(uint64_t dest, uint64_t src, int shift, int len)
{
    uint64_t mask;

    if (len == 0) {
        mask = ~0ULL;
    } else {
        mask = (1ULL << len) - 1;
    }
    return (dest & ~(mask << shift)) | ((src & mask) << shift);
}

void helper_insertq_r(CPUX86State *env, ZMMReg *d, ZMMReg *s)
{
    d->_q_ZMMReg[0] = helper_insertq(d->_q_ZMMReg[0], s->_q_ZMMReg[0], s->_b_ZMMReg[9] & 63, s->_b_ZMMReg[8] & 63);
}

void helper_insertq_i(CPUX86State *env, ZMMReg *d, ZMMReg *s, int index, int length)
{
    d->_q_ZMMReg[0] = helper_insertq(d->_q_ZMMReg[0], s->_q_ZMMReg[0], index, length);
}
