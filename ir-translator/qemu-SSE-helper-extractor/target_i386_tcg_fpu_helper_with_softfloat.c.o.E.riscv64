uint64_t helper_xgetbv(CPUX86State *env, uint32_t ecx)
{

    if (!(env->cr[4] & (1U << 18))) {
        raise_exception_ra(env, 6, ((uintptr_t)__builtin_extract_return_addr(__builtin_return_address(0))));
    }

    switch (ecx) {
    case 0:
        return env->xcr0;
    case 1:
