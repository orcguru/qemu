    for (i = 0; i < 2 << 1; i++) {
        d->_h_ZMMReg[i] = float32_to_float16(s->_s_ZMMReg[i], 1, &env->sse_status);
    }
    for (i >>= 2; i < 1 << 1; i++) {
        d->_q_ZMMReg[i] = 0;
    }

    env->sse_status.float_rounding_mode = prev_rounding_mode;
}



