static inline uint32_t cpu_compute_eflags(CPUX86State *env)
{
    uint32_t eflags = env->eflags;
    if ((tcg_allowed)) {
        eflags |= cpu_cc_compute_all(env) | (env->df & 0x00000400);
    }
    return eflags;
}

static inline MemTxAttrs cpu_get_mem_attrs(CPUX86State *env)
{
    return ((MemTxAttrs) { .secure = (env->hflags & (1 << 19)) != 0 });
}

static inline int32_t x86_get_a20_mask(CPUX86State *env)
{
    if (env->hflags & (1 << 19)) {
        return -1;
    } else {
        return env->a20_mask;
    }
}

static inline uint32_t x86_cpu_family(uint32_t eax)
{
    uint32_t family = (eax >> 8) & 0xf;

    if (family == 0xf) {
        family += (eax >> 20) & 0xff;
    }

    return family;
}

static inline uint32_t x86_cpu_model(uint32_t eax)
{
    uint32_t family, model;

    family = x86_cpu_family(eax);
    model = (eax >> 4) & 0xf;

    if (family >= 0x6) {
        model += ((eax >> 16) & 0xf) << 4;
    }

    return model;
}

static inline uint32_t x86_cpu_stepping(uint32_t eax)
{
    return eax & 0xf;
}

static inline _Bool cpu_has_vmx(CPUX86State *env)
{
    return env->features[FEAT_1_ECX] & (1U << 5);
}

static inline _Bool cpu_has_svm(CPUX86State *env)
{
    return env->features[FEAT_8000_0001_ECX] & (1U << 2);
}
