        break;
    }
    raise_exception_ra(env, 13, ((uintptr_t)__builtin_extract_return_addr(__builtin_return_address(0))));
}

void helper_xsetbv(CPUX86State *env, uint32_t ecx, uint64_t mask)
{
    uint32_t dummy, ena_lo, ena_hi;
    uint64_t ena;


    if (!(env->cr[4] & (1U << 18))) {
        raise_exception_ra(env, 6, ((uintptr_t)__builtin_extract_return_addr(__builtin_return_address(0))));
    }


    if (ecx != 0 || (mask & (1ULL << 0)) == 0) {
        goto do_gpf;
    }


    if ((mask & ((1ULL << 1) | (1ULL << 2))) == (1ULL << 2)) {
        goto do_gpf;
    }


    cpu_x86_cpuid(env, 0x0d, 0, &ena_lo, &dummy, &dummy, &ena_hi);
    ena = ((uint64_t)ena_hi << 32) | ena_lo;
    if (mask & ~ena) {
        goto do_gpf;
    }


    if ((mask ^ (mask * ((1ULL << 4) / (1ULL << 3))))
        & (1ULL << 4)) {
        goto do_gpf;
    }

    env->xcr0 = mask;
    cpu_sync_bndcs_hflags(env);
    cpu_sync_avx_hflag(env);
    return;

 do_gpf:
    raise_exception_ra(env, 13, ((uintptr_t)__builtin_extract_return_addr(__builtin_return_address(0))));
}
