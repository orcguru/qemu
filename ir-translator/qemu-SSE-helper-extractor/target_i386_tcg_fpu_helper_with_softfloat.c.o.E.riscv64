void update_mxcsr_status(CPUX86State *env)
{
    uint32_t mxcsr = env->mxcsr;
    int rnd_type;


    rnd_type = (mxcsr & (3 << 13)) >> 13;
    set_x86_rounding_mode(rnd_type, &env->sse_status);


    set_float_exception_flags((mxcsr & (1 << 0) ? float_flag_invalid : 0) |
                              (mxcsr & (1 << 1) ? float_flag_input_denormal_used : 0) |
                              (mxcsr & (1 << 2) ? float_flag_divbyzero : 0) |
                              (mxcsr & (1 << 3) ? float_flag_overflow : 0) |
                              (mxcsr & (1 << 4) ? float_flag_underflow : 0) |
                              (mxcsr & (1 << 5) ? float_flag_inexact : 0),
                              &env->sse_status);


    set_flush_inputs_to_zero((mxcsr & 0x0040) ? 1 : 0, &env->sse_status);


    set_flush_to_zero((mxcsr & 0x8000) ? 1 : 0, &env->sse_status);
}

void update_mxcsr_from_sse_status(CPUX86State *env)
{
    int flags = get_float_exception_flags(&env->sse_status);
    env->mxcsr |= ((flags & float_flag_invalid ? (1 << 0) : 0) |
                   (flags & float_flag_input_denormal_used ? (1 << 1) : 0) |
                   (flags & float_flag_divbyzero ? (1 << 2) : 0) |
                   (flags & float_flag_overflow ? (1 << 3) : 0) |
                   (flags & float_flag_underflow ? (1 << 4) : 0) |
                   (flags & float_flag_inexact ? (1 << 5) : 0) |
                   (flags & float_flag_output_denormal_flushed ? (1 << 4) | (1 << 5) :
                    0));
}

void helper_update_mxcsr(CPUX86State *env)
{
    update_mxcsr_from_sse_status(env);
}

