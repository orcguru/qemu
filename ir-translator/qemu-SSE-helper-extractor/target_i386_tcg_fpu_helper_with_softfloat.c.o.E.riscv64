void helper_aeskeygenassist_xmm(CPUX86State *env, ZMMReg *d, ZMMReg *s,
                                          uint32_t ctrl)
{
    int i;
    ZMMReg tmp = *s;

    for (i = 0 ; i < 4 ; i++) {
        d->_b_ZMMReg[i] = AES_sbox[tmp._b_ZMMReg[i + 4]];
        d->_b_ZMMReg[i + 8] = AES_sbox[tmp._b_ZMMReg[i + 12]];
    }
    d->_l_ZMMReg[1] = (d->_l_ZMMReg[0] << 24 | d->_l_ZMMReg[0] >> 8) ^ ctrl;
    d->_l_ZMMReg[3] = (d->_l_ZMMReg[2] << 24 | d->_l_ZMMReg[2] >> 8) ^ ctrl;
}




void helper_vpermilpd_xmm(CPUX86State *env, ZMMReg *d, ZMMReg *v, ZMMReg *s)
{
    uint64_t r0, r1;
    int i;

    for (i = 0; i < 1 << 1; i += 2) {
        r0 = v->_q_ZMMReg[i + ((s->_q_ZMMReg[i] >> 1) & 1)];
        r1 = v->_q_ZMMReg[i + ((s->_q_ZMMReg[i+1] >> 1) & 1)];
        d->_q_ZMMReg[i] = r0;
        d->_q_ZMMReg[i+1] = r1;
    }
}

void helper_vpermilps_xmm(CPUX86State *env, ZMMReg *d, ZMMReg *v, ZMMReg *s)
{
    uint32_t r0, r1, r2, r3;
    int i;

    for (i = 0; i < 2 << 1; i += 4) {
        r0 = v->_l_ZMMReg[i + (s->_l_ZMMReg[i] & 3)];
        r1 = v->_l_ZMMReg[i + (s->_l_ZMMReg[i+1] & 3)];
        r2 = v->_l_ZMMReg[i + (s->_l_ZMMReg[i+2] & 3)];
        r3 = v->_l_ZMMReg[i + (s->_l_ZMMReg[i+3] & 3)];
        d->_l_ZMMReg[i] = r0;
        d->_l_ZMMReg[i+1] = r1;
        d->_l_ZMMReg[i+2] = r2;
        d->_l_ZMMReg[i+3] = r3;
    }
}

void helper_vpermilpd_imm_xmm(ZMMReg *d, ZMMReg *s, uint32_t order)
{
    uint64_t r0, r1;
    int i;

    for (i = 0; i < 1 << 1; i += 2) {
        r0 = s->_q_ZMMReg[i + ((order >> 0) & 1)];
        r1 = s->_q_ZMMReg[i + ((order >> 1) & 1)];
        d->_q_ZMMReg[i] = r0;
        d->_q_ZMMReg[i+1] = r1;

        order >>= 2;
    }
}

void helper_vpermilps_imm_xmm(ZMMReg *d, ZMMReg *s, uint32_t order)
{
    uint32_t r0, r1, r2, r3;
    int i;

    for (i = 0; i < 2 << 1; i += 4) {
        r0 = s->_l_ZMMReg[i + ((order >> 0) & 3)];
        r1 = s->_l_ZMMReg[i + ((order >> 2) & 3)];
        r2 = s->_l_ZMMReg[i + ((order >> 4) & 3)];
        r3 = s->_l_ZMMReg[i + ((order >> 6) & 3)];
        d->_l_ZMMReg[i] = r0;
        d->_l_ZMMReg[i+1] = r1;
        d->_l_ZMMReg[i+2] = r2;
        d->_l_ZMMReg[i+3] = r3;
    }
}
