static const int comis_eflags[4] = {0x0001, 0x0040, 0, 0x0040 | 0x0004 | 0x0001};

void helper_ucomiss(CPUX86State *env, ZMMReg *d, ZMMReg *s)
{
    FloatRelation ret;
    float32 s0, s1;

    s0 = d->_s_ZMMReg[0];
    s1 = s->_s_ZMMReg[0];
    ret = float32_compare_quiet(s0, s1, &env->sse_status);
    (env->cc_src) = comis_eflags[ret + 1];
    (env->cc_op) = CC_OP_EFLAGS;
}

void helper_comiss(CPUX86State *env, ZMMReg *d, ZMMReg *s)
{
    FloatRelation ret;
    float32 s0, s1;

    s0 = d->_s_ZMMReg[0];
    s1 = s->_s_ZMMReg[0];
    ret = float32_compare(s0, s1, &env->sse_status);
    (env->cc_src) = comis_eflags[ret + 1];
    (env->cc_op) = CC_OP_EFLAGS;
}

