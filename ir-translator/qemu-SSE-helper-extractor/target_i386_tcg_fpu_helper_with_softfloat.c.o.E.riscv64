    d->_w_ZMMReg[0] = s->_w_ZMMReg[idx];
    d->_w_ZMMReg[1] = idx;
    d->_l_ZMMReg[1] = 0;
    d->_q_ZMMReg[1] = 0;
}


void helper_roundps_xmm(CPUX86State *env, ZMMReg *d, ZMMReg *s,
                                  uint32_t mode)
{
    int old_flags = get_float_exception_flags(&env->sse_status);
    signed char prev_rounding_mode;
    int i;

    prev_rounding_mode = env->sse_status.float_rounding_mode;
    if (!(mode & (1 << 2))) {
        set_x86_rounding_mode(mode & 3, &env->sse_status);
    }

    for (i = 0; i < 2 << 1; i++) {
        d->_s_ZMMReg[i] = float32_round_to_int(s->_s_ZMMReg[i], &env->sse_status);
    }

    if (mode & (1 << 3) && !(old_flags & float_flag_inexact)) {
        set_float_exception_flags(get_float_exception_flags(&env->sse_status) &
                                  ~float_flag_inexact,
                                  &env->sse_status);
    }
    env->sse_status.float_rounding_mode = prev_rounding_mode;
}

