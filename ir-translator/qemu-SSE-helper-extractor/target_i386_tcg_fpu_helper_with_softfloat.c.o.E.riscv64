}

static void do_fxsave(X86Access *ac, target_ulong ptr)
{
    CPUX86State *env = ac->env;

    do_xsave_fpu(ac, ptr);
    if (env->cr[4] & (1U << 9)) {
        do_xsave_mxcsr(ac, ptr);

        if (!(env->efer & (1 << 14))
            || (env->hflags & (3 << 0))
            || !(env->hflags & (1 << 14))) {
            do_xsave_sse(ac, ptr);
        }
    }
}

