    access_prepare(&ac, env, ptr, sizeof(X86LegacyXSaveArea),
                   MMU_DATA_LOAD, ra);
    do_fxrstor(&ac, ptr);
}

static _Bool valid_xrstor_header(X86Access *ac, uint64_t *pxsbv,
                                target_ulong ptr)
{
    uint64_t xstate_bv, xcomp_bv, reserve0;

    xstate_bv = access_ldq(ac, ptr + __builtin_offsetof(X86XSaveArea, header.xstate_bv));
    xcomp_bv = access_ldq(ac, ptr + __builtin_offsetof(X86XSaveArea, header.xcomp_bv));
    reserve0 = access_ldq(ac, ptr + __builtin_offsetof(X86XSaveArea, header.reserve0));
    *pxsbv = xstate_bv;







    if (xcomp_bv || reserve0) {
        return 0;
    }


    return (xstate_bv & ~ac->env->xcr0) == 0;
}

static void do_xrstor(X86Access *ac, target_ulong ptr,
                      uint64_t rfbm, uint64_t xstate_bv)
{
    CPUX86State *env = ac->env;

    if (rfbm & (1ULL << 0)) {
        if (xstate_bv & (1ULL << 0)) {
            do_xrstor_fpu(ac, ptr);
        } else {
            do_fninit(env);
            memset(env->fpregs, 0, sizeof(env->fpregs));
        }
    }
    if (rfbm & (1ULL << 1)) {


        do_xrstor_mxcsr(ac, ptr);
        if (xstate_bv & (1ULL << 1)) {
            do_xrstor_sse(ac, ptr);
        } else {
            do_clear_sse(env);
        }
    }
    if (rfbm & (1ULL << 2)) {
        if (xstate_bv & (1ULL << 2)) {
            do_xrstor_ymmh(ac, ptr + __builtin_offsetof(X86XSaveArea, avx_state));
        } else {
            do_clear_ymmh(env);
        }
    }
    if (rfbm & (1ULL << 3)) {
        if (xstate_bv & (1ULL << 3)) {
            do_xrstor_bndregs(ac, ptr + __builtin_offsetof(X86XSaveArea, bndreg_state));
            env->hflags |= (1 << 26);
        } else {
            memset(env->bnd_regs, 0, sizeof(env->bnd_regs));
            env->hflags &= ~(1 << 26);
        }
    }
    if (rfbm & (1ULL << 4)) {
        if (xstate_bv & (1ULL << 4)) {
            do_xrstor_bndcsr(ac, ptr + __builtin_offsetof(X86XSaveArea, bndcsr_state));
        } else {
            memset(&env->bndcs_regs, 0, sizeof(env->bndcs_regs));
        }
        cpu_sync_bndcs_hflags(env);
    }
    if (rfbm & (1ULL << 9)) {
        uint64_t old_pkru = env->pkru;
        if (xstate_bv & (1ULL << 9)) {
            do_xrstor_pkru(ac, ptr + __builtin_offsetof(X86XSaveArea, pkru_state));
        } else {
            env->pkru = 0;
        }
        if (env->pkru != old_pkru) {
            CPUState *cs = env_cpu(env);
            tlb_flush(cs);
        }
    }
}



void helper_xrstor(CPUX86State *env, target_ulong ptr, uint64_t rfbm)
{
    uintptr_t ra = ((uintptr_t)__builtin_extract_return_addr(__builtin_return_address(0)));
    X86Access ac;
    uint64_t xstate_bv;
    unsigned size, size_ext;

    do_xsave_chk(env, ptr, ra);


    size = sizeof(X86LegacyXSaveArea) + sizeof(X86XSaveHeader);
    access_prepare(&ac, env, ptr, size, MMU_DATA_LOAD, ra);
    if (!valid_xrstor_header(&ac, &xstate_bv, ptr)) {
        raise_exception_ra(env, 13, ra);
    }

    rfbm &= env->xcr0;
    size_ext = xsave_area_size(rfbm & xstate_bv, 0);
    if (size < size_ext) {

        access_prepare(&ac, env, ptr, size_ext, MMU_DATA_LOAD, ra);
    }

    do_xrstor(&ac, ptr, rfbm, xstate_bv);
}


