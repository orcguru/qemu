    access_stw(ac, ptr + __builtin_offsetof(X86XSaveArea, legacy.fsw), fpus);
    access_stw(ac, ptr + __builtin_offsetof(X86XSaveArea, legacy.ftw), fptag ^ 0xff);




    access_stq(ac, ptr + __builtin_offsetof(X86XSaveArea, legacy.fpip), 0);
    access_stq(ac, ptr + __builtin_offsetof(X86XSaveArea, legacy.fpdp), 0);

    addr = ptr + __builtin_offsetof(X86XSaveArea, legacy.fpregs);

    for (i = 0; i < 8; i++) {
        floatx80 tmp = (env->fpregs[(env->fpstt + (i)) & 7].d);
        do_fstt(ac, addr, tmp);
        addr += 16;
