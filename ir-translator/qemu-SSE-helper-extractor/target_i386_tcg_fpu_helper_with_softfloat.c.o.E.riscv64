void helper_blendps_xmm(CPUX86State *env, ZMMReg *d, ZMMReg *v, ZMMReg *s, uint32_t imm) { int i; for (i = 0; i < 2 << 1; i++) { int j = i & 7; d->_l_ZMMReg[i] = ((imm >> j) & 1 ? s->_l_ZMMReg[i] : v->_l_ZMMReg[i]); } }
void helper_blendpd_xmm(CPUX86State *env, ZMMReg *d, ZMMReg *v, ZMMReg *s, uint32_t imm) { int i; for (i = 0; i < 1 << 1; i++) { int j = i & 7; d->_q_ZMMReg[i] = ((imm >> j) & 1 ? s->_q_ZMMReg[i] : v->_q_ZMMReg[i]); } }
void helper_pblendw_xmm(CPUX86State *env, ZMMReg *d, ZMMReg *v, ZMMReg *s, uint32_t imm) { int i; for (i = 0; i < 4 << 1; i++) { int j = i & 7; d->_w_ZMMReg[i] = ((imm >> j) & 1 ? s->_w_ZMMReg[i] : v->_w_ZMMReg[i]); } }

void helper_dpps_xmm(CPUX86State *env, ZMMReg *d, ZMMReg *v, ZMMReg *s,
                               uint32_t mask)
{
    float32 prod1, prod2, temp2, temp3, temp4;
    int i;

    for (i = 0; i < 2 << 1; i += 4) {




        if (mask & (1 << 4)) {
            prod1 = float32_mul(v->_s_ZMMReg[i], s->_s_ZMMReg[i], &env->sse_status);
        } else {
            prod1 = (0);
        }
        if (mask & (1 << 5)) {
            prod2 = float32_mul(v->_s_ZMMReg[i+1], s->_s_ZMMReg[i+1], &env->sse_status);
        } else {
            prod2 = (0);
        }
        temp2 = float32_add(prod1, prod2, &env->sse_status);
        if (mask & (1 << 6)) {
            prod1 = float32_mul(v->_s_ZMMReg[i+2], s->_s_ZMMReg[i+2], &env->sse_status);
        } else {
            prod1 = (0);
        }
        if (mask & (1 << 7)) {
            prod2 = float32_mul(v->_s_ZMMReg[i+3], s->_s_ZMMReg[i+3], &env->sse_status);
        } else {
            prod2 = (0);
        }
        temp3 = float32_add(prod1, prod2, &env->sse_status);
        temp4 = float32_add(temp2, temp3, &env->sse_status);

        d->_s_ZMMReg[i] = (mask & (1 << 0)) ? temp4 : (0);
        d->_s_ZMMReg[i+1] = (mask & (1 << 1)) ? temp4 : (0);
        d->_s_ZMMReg[i+2] = (mask & (1 << 2)) ? temp4 : (0);
        d->_s_ZMMReg[i+3] = (mask & (1 << 3)) ? temp4 : (0);
    }
}



void helper_dppd_xmm(CPUX86State *env,
                               ZMMReg *d, ZMMReg *v, ZMMReg *s, uint32_t mask)
{
    float64 prod1, prod2, temp2;

    if (mask & (1 << 4)) {
        prod1 = float64_mul(v->_d_ZMMReg[0], s->_d_ZMMReg[0], &env->sse_status);
    } else {
        prod1 = (0);
    }
    if (mask & (1 << 5)) {
        prod2 = float64_mul(v->_d_ZMMReg[1], s->_d_ZMMReg[1], &env->sse_status);
    } else {
        prod2 = (0);
    }
    temp2 = float64_add(prod1, prod2, &env->sse_status);
    d->_d_ZMMReg[0] = (mask & (1 << 0)) ? temp2 : (0);
    d->_d_ZMMReg[1] = (mask & (1 << 1)) ? temp2 : (0);
}


void helper_mpsadbw_xmm(CPUX86State *env, ZMMReg *d, ZMMReg *v, ZMMReg *s,
                                  uint32_t offset)
{
    int i, j;
    uint16_t r[8];

    for (j = 0; j < 4 << 1; ) {
        int s0 = (j * 2) + ((offset & 3) << 2);
        int d0 = (j * 2) + ((offset & 4) << 0);
        for (i = 0; i < (1 ? 16 : 8) / 2; i++, d0++) {
            r[i] = 0;
            r[i] += abs1(v->_b_ZMMReg[d0 + 0] - s->_b_ZMMReg[s0 + 0]);
            r[i] += abs1(v->_b_ZMMReg[d0 + 1] - s->_b_ZMMReg[s0 + 1]);
            r[i] += abs1(v->_b_ZMMReg[d0 + 2] - s->_b_ZMMReg[s0 + 2]);
            r[i] += abs1(v->_b_ZMMReg[d0 + 3] - s->_b_ZMMReg[s0 + 3]);
        }
        for (i = 0; i < (1 ? 16 : 8) / 2; i++, j++) {
            d->_w_ZMMReg[j] = r[i];
        }
        offset >>= 3;
    }
}



static inline int pcmp_elen(CPUX86State *env, int reg, uint32_t ctrl)
{
    target_long val, limit;


    if (ctrl >> 8) {
        val = (target_long)env->regs[reg];
    } else {
        val = (int32_t)env->regs[reg];
    }
    if (ctrl & 1) {
        limit = 8;
    } else {
        limit = 16;
    }
    if ((val > limit) || (val < -limit)) {
        return limit;
    }
    return abs1(val);
}

static inline int pcmp_ilen(ZMMReg *r, uint8_t ctrl)
{
    int val = 0;

    if (ctrl & 1) {
        while (val < 8 && r->_w_ZMMReg[val]) {
            val++;
        }
    } else {
        while (val < 16 && r->_b_ZMMReg[val]) {
            val++;
        }
    }

    return val;
}

static inline int pcmp_val(ZMMReg *r, uint8_t ctrl, int i)
{
    switch ((ctrl >> 0) & 3) {
    case 0:
        return r->_b_ZMMReg[i];
    case 1:
        return r->_w_ZMMReg[i];
    case 2:
        return (int8_t)r->_b_ZMMReg[i];
    case 3:
    default:
        return (int16_t)r->_w_ZMMReg[i];
    }
}

static inline unsigned pcmpxstrx(CPUX86State *env, ZMMReg *d, ZMMReg *s,
                                 uint8_t ctrl, int valids, int validd)
{
    unsigned int res = 0;
    int v;
    int j, i;
    int upper = (ctrl & 1) ? 7 : 15;

    valids--;
    validd--;

    (env->cc_src) = (valids < upper ? 0x0040 : 0) | (validd < upper ? 0x0080 : 0);
    (env->cc_op) = CC_OP_EFLAGS;

    switch ((ctrl >> 2) & 3) {
    case 0:
        for (j = valids; j >= 0; j--) {
            res <<= 1;
            v = pcmp_val(s, ctrl, j);
            for (i = validd; i >= 0; i--) {
                res |= (v == pcmp_val(d, ctrl, i));
            }
        }
        break;
    case 1:
        for (j = valids; j >= 0; j--) {
            res <<= 1;
            v = pcmp_val(s, ctrl, j);
            for (i = ((validd - 1) | 1); i >= 0; i -= 2) {
                res |= (pcmp_val(d, ctrl, i - 0) >= v &&
                        pcmp_val(d, ctrl, i - 1) <= v);
            }
        }
        break;
    case 2:
        res = (1 << (upper - ({ typeof(1 ? ((valids)) : ((validd))) _a70 = ((valids)), _b71 = ((validd)); _a70 > _b71 ? _a70 : _b71; }))) - 1;
        res <<= ({ typeof(1 ? ((valids)) : ((validd))) _a72 = ((valids)), _b73 = ((validd)); _a72 > _b73 ? _a72 : _b73; }) - ({ typeof(1 ? ((valids)) : ((validd))) _a74 = ((valids)), _b75 = ((validd)); _a74 < _b75 ? _a74 : _b75; });
        for (i = ({ typeof(1 ? ((valids)) : ((validd))) _a76 = ((valids)), _b77 = ((validd)); _a76 < _b77 ? _a76 : _b77; }); i >= 0; i--) {
            res <<= 1;
            v = pcmp_val(s, ctrl, i);
            res |= (v == pcmp_val(d, ctrl, i));
        }
        break;
    case 3:
        if (validd == -1) {
            res = (2 << upper) - 1;
            break;
        }
        for (j = valids == upper ? valids : valids - validd; j >= 0; j--) {
            res <<= 1;
            v = 1;
            for (i = ({ typeof(1 ? ((valids - j)) : ((validd))) _a78 = ((valids - j)), _b79 = ((validd)); _a78 < _b79 ? _a78 : _b79; }); i >= 0; i--) {
                v &= (pcmp_val(s, ctrl, i + j) == pcmp_val(d, ctrl, i));
            }
            res |= v;
        }
        break;
    }

    switch ((ctrl >> 4) & 3) {
    case 1:
        res ^= (2 << upper) - 1;
        break;
    case 3:
        res ^= (1 << (valids + 1)) - 1;
        break;
    }

    if (res) {
        (env->cc_src) |= 0x0001;
    }
    if (res & 1) {
        (env->cc_src) |= 0x0800;
    }

    return res;
}

void helper_pcmpestri_xmm(CPUX86State *env, ZMMReg *d, ZMMReg *s,
                                    uint32_t ctrl)
{
    unsigned int res = pcmpxstrx(env, d, s, ctrl,
                                 pcmp_elen(env, R_EDX, ctrl),
                                 pcmp_elen(env, R_EAX, ctrl));

    if (res) {
        env->regs[R_ECX] = (ctrl & (1 << 6)) ? 31 - clz32(res) : ctz32(res);
    } else {
        env->regs[R_ECX] = 16 >> (ctrl & (1 << 0));
    }
}

void helper_pcmpestrm_xmm(CPUX86State *env, ZMMReg *d, ZMMReg *s,
                                    uint32_t ctrl)
{
    int i;
    unsigned int res = pcmpxstrx(env, d, s, ctrl,
                                 pcmp_elen(env, R_EDX, ctrl),
                                 pcmp_elen(env, R_EAX, ctrl));

    if ((ctrl >> 6) & 1) {
        if (ctrl & 1) {
            for (i = 0; i < 8; i++, res >>= 1) {
                env->xmm_regs[0]._w_ZMMReg[i] = (res & 1) ? ~0 : 0;
            }
        } else {
            for (i = 0; i < 16; i++, res >>= 1) {
                env->xmm_regs[0]._b_ZMMReg[i] = (res & 1) ? ~0 : 0;
            }
        }
    } else {
        env->xmm_regs[0]._q_ZMMReg[1] = 0;
        env->xmm_regs[0]._q_ZMMReg[0] = res;
    }
}

void helper_pcmpistri_xmm(CPUX86State *env, ZMMReg *d, ZMMReg *s,
                                    uint32_t ctrl)
{
    unsigned int res = pcmpxstrx(env, d, s, ctrl,
                                 pcmp_ilen(s, ctrl),
                                 pcmp_ilen(d, ctrl));

    if (res) {
        env->regs[R_ECX] = (ctrl & (1 << 6)) ? 31 - clz32(res) : ctz32(res);
    } else {
        env->regs[R_ECX] = 16 >> (ctrl & (1 << 0));
    }
}

void helper_pcmpistrm_xmm(CPUX86State *env, ZMMReg *d, ZMMReg *s,
                                    uint32_t ctrl)
{
    int i;
    unsigned int res = pcmpxstrx(env, d, s, ctrl,
                                 pcmp_ilen(s, ctrl),
                                 pcmp_ilen(d, ctrl));

    if ((ctrl >> 6) & 1) {
        if (ctrl & 1) {
            for (i = 0; i < 8; i++, res >>= 1) {
                env->xmm_regs[0]._w_ZMMReg[i] = (res & 1) ? ~0 : 0;
            }
        } else {
            for (i = 0; i < 16; i++, res >>= 1) {
                env->xmm_regs[0]._b_ZMMReg[i] = (res & 1) ? ~0 : 0;
            }
        }
    } else {
        env->xmm_regs[0]._q_ZMMReg[1] = 0;
        env->xmm_regs[0]._q_ZMMReg[0] = res;
