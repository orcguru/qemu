static inline void fpush(CPUX86State *env)
{
    env->fpstt = (env->fpstt - 1) & 7;
    env->fptags[env->fpstt] = 0;
}

static inline void fpop(CPUX86State *env)
{
    env->fptags[env->fpstt] = 1;
    env->fpstt = (env->fpstt + 1) & 7;
}

static floatx80 do_fldt(X86Access *ac, target_ulong ptr)
{
    CPU_LDoubleU temp;

    temp.l.lower = access_ldq(ac, ptr);
    temp.l.upper = access_ldw(ac, ptr + 8);
    return temp.d;
}

static void do_fstt(X86Access *ac, target_ulong ptr, floatx80 f)
{
    CPU_LDoubleU temp;

    temp.d = f;
    access_stq(ac, ptr, temp.l.lower);
    access_stw(ac, ptr + 8, temp.l.upper);
}



static inline double floatx80_to_double(CPUX86State *env, floatx80 a)
{
    union {
        float64 f64;
        double d;
    } u;

    u.f64 = floatx80_to_float64(a, &env->fp_status);
    return u.d;
}

static inline floatx80 double_to_floatx80(CPUX86State *env, double a)
{
    union {
        float64 f64;
        double d;
    } u;

    u.d = a;
    return float64_to_floatx80(u.f64, &env->fp_status);
}

static void fpu_set_exception(CPUX86State *env, int mask)
{
    env->fpus |= mask;
    if (env->fpus & (~env->fpuc & 0x3f)) {
        env->fpus |= (1 << 7) | (1 << 15);
    }
}

void cpu_init_fp_statuses(CPUX86State *env)
{
# 5542 "../../Github/qemu-runtime/target/i386/tcg/fpu_helper.c"
    set_float_2nan_prop_rule(float_2nan_prop_x87, &env->fp_status);
# 5557 "../../Github/qemu-runtime/target/i386/tcg/fpu_helper.c"
    set_float_2nan_prop_rule(float_2nan_prop_x87, &env->mmx_status);
    set_float_2nan_prop_rule(float_2nan_prop_x87, &env->sse_status);







    set_float_infzeronan_rule(float_infzeronan_dnan_never |
                              float_infzeronan_suppress_invalid,
                              &env->sse_status);
    set_float_3nan_prop_rule(float_3nan_prop_abc, &env->sse_status);

    set_float_default_nan_pattern(0b11000000, &env->fp_status);
    set_float_default_nan_pattern(0b11000000, &env->mmx_status);
    set_float_default_nan_pattern(0b11000000, &env->sse_status);





    set_float_ftz_detection(float_ftz_after_rounding, &env->fp_status);
    set_float_ftz_detection(float_ftz_after_rounding, &env->mmx_status);
    set_float_ftz_detection(float_ftz_after_rounding, &env->sse_status);
}

static inline int save_exception_flags(CPUX86State *env)
{
    int old_flags = get_float_exception_flags(&env->fp_status);
    set_float_exception_flags(0, &env->fp_status);
    return old_flags;
}

static void merge_exception_flags(CPUX86State *env, int old_flags)
{
    int new_flags = get_float_exception_flags(&env->fp_status);
    float_raise(old_flags, &env->fp_status);
    fpu_set_exception(env,
                      ((new_flags & float_flag_invalid ? (1 << 0) : 0) |
                       (new_flags & float_flag_divbyzero ? (1 << 2) : 0) |
                       (new_flags & float_flag_overflow ? (1 << 3) : 0) |
                       (new_flags & float_flag_underflow ? (1 << 4) : 0) |
                       (new_flags & float_flag_inexact ? (1 << 5) : 0) |
                       (new_flags & float_flag_input_denormal_used ? (1 << 1) : 0)));
}

static inline floatx80 helper_fdiv(CPUX86State *env, floatx80 a, floatx80 b)
{
    int old_flags = save_exception_flags(env);
    floatx80 ret = floatx80_div(a, b, &env->fp_status);
    merge_exception_flags(env, old_flags);
    return ret;
}

static void fpu_raise_exception(CPUX86State *env, uintptr_t retaddr)
{
    if (env->cr[0] & (1U << 5)) {
        raise_exception_ra(env, 16, retaddr);
    }





}

void helper_flds_FT0(CPUX86State *env, uint32_t val)
{
    int old_flags = save_exception_flags(env);
    union {
        float32 f;
        uint32_t i;
    } u;

    u.i = val;
    (env->ft0) = float32_to_floatx80(u.f, &env->fp_status);
    merge_exception_flags(env, old_flags);
}

