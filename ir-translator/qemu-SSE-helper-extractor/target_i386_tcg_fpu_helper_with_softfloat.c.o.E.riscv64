    do_xsave(env, ptr, rfbm, inuse, inuse, ((uintptr_t)__builtin_extract_return_addr(__builtin_return_address(0))));
}

static void do_xrstor_fpu(X86Access *ac, target_ulong ptr)
{
    CPUX86State *env = ac->env;
    int i, fpuc, fpus, fptag;
    target_ulong addr;

    fpuc = access_ldw(ac, ptr + __builtin_offsetof(X86XSaveArea, legacy.fcw));
    fpus = access_ldw(ac, ptr + __builtin_offsetof(X86XSaveArea, legacy.fsw));
    fptag = access_ldw(ac, ptr + __builtin_offsetof(X86XSaveArea, legacy.ftw));
    cpu_set_fpuc(env, fpuc);
    cpu_set_fpus(env, fpus);

    fptag ^= 0xff;
    for (i = 0; i < 8; i++) {
        env->fptags[i] = ((fptag >> i) & 1);
    }

    addr = ptr + __builtin_offsetof(X86XSaveArea, legacy.fpregs);

    for (i = 0; i < 8; i++) {
        floatx80 tmp = do_fldt(ac, addr);
        (env->fpregs[(env->fpstt + (i)) & 7].d) = tmp;
        addr += 16;
    }
}

static void do_xrstor_mxcsr(X86Access *ac, target_ulong ptr)
{
    CPUX86State *env = ac->env;
    cpu_set_mxcsr(env, access_ldl(ac, ptr + __builtin_offsetof(X86XSaveArea, legacy.mxcsr)));
}

static void do_xrstor_sse(X86Access *ac, target_ulong ptr)
{
    CPUX86State *env = ac->env;
    int i, nb_xmm_regs;
    target_ulong addr;

    if (env->hflags & (1 << 15)) {
        nb_xmm_regs = 16;
    } else {
        nb_xmm_regs = 8;
    }

    addr = ptr + __builtin_offsetof(X86XSaveArea, legacy.xmm_regs);
    for (i = 0; i < nb_xmm_regs; i++) {
        env->xmm_regs[i]._q_ZMMReg[0] = access_ldq(ac, addr);
        env->xmm_regs[i]._q_ZMMReg[1] = access_ldq(ac, addr + 8);
        addr += 16;
    }
}

static void do_clear_sse(CPUX86State *env)
{
