static uint64_t get_xinuse(CPUX86State *env)
{
    uint64_t inuse = -1;





    if ((env->hflags & (1 << 26)) == 0) {
       inuse &= ~(1ULL << 3);
    }
    return inuse;
}

static void do_xsave_access(X86Access *ac, target_ulong ptr, uint64_t rfbm,
                            uint64_t inuse, uint64_t opt)
{
    uint64_t old_bv, new_bv;

    if (opt & (1ULL << 0)) {
        do_xsave_fpu(ac, ptr);
    }
    if (rfbm & (1ULL << 1)) {

        do_xsave_mxcsr(ac, ptr);
    }
    if (opt & (1ULL << 1)) {
        do_xsave_sse(ac, ptr);
    }
    if (opt & (1ULL << 2)) {
        do_xsave_ymmh(ac, ptr + __builtin_offsetof(X86XSaveArea, avx_state));
    }
    if (opt & (1ULL << 3)) {
        do_xsave_bndregs(ac, ptr + __builtin_offsetof(X86XSaveArea, bndreg_state));
    }
    if (opt & (1ULL << 4)) {
        do_xsave_bndcsr(ac, ptr + __builtin_offsetof(X86XSaveArea, bndcsr_state));
    }
    if (opt & (1ULL << 9)) {
        do_xsave_pkru(ac, ptr + __builtin_offsetof(X86XSaveArea, pkru_state));
    }


    old_bv = access_ldq(ac, ptr + __builtin_offsetof(X86XSaveArea, header.xstate_bv));
    new_bv = (old_bv & ~rfbm) | (inuse & rfbm);
    access_stq(ac, ptr + __builtin_offsetof(X86XSaveArea, header.xstate_bv), new_bv);
}

static void do_xsave_chk(CPUX86State *env, target_ulong ptr, uintptr_t ra)
{

    if (!(env->cr[4] & (1U << 18))) {
        raise_exception_ra(env, 6, ra);
    }


    if (ptr & 63) {
        raise_exception_ra(env, 13, ra);
    }
}

static void do_xsave(CPUX86State *env, target_ulong ptr, uint64_t rfbm,
                     uint64_t inuse, uint64_t opt, uintptr_t ra)
{
    X86Access ac;
    unsigned size;

    do_xsave_chk(env, ptr, ra);


    rfbm &= env->xcr0;
    opt &= rfbm;
    size = xsave_area_size(opt, 0);

    access_prepare(&ac, env, ptr, size, MMU_DATA_STORE, ra);
    do_xsave_access(&ac, ptr, rfbm, inuse, opt);
}

void helper_xsave(CPUX86State *env, target_ulong ptr, uint64_t rfbm)
{
    do_xsave(env, ptr, rfbm, get_xinuse(env), rfbm, ((uintptr_t)__builtin_extract_return_addr(__builtin_return_address(0))));
}

void helper_xsaveopt(CPUX86State *env, target_ulong ptr, uint64_t rfbm)
{
