    union_float32 ua, ur;

    ua.s = xa;
    if (__builtin_expect(!!(!can_use_fpu(s)), 0)) {
        goto soft;
    }

    float32_input_flush1(&ua.s, s);
    if (0) {
        if (__builtin_expect(!!(!(__builtin_fpclassify (0, 1, 4, 3, 2, ua.h) == 4 || __builtin_fpclassify (0, 1, 4, 3, 2, ua.h) == 2) || __builtin_signbit (ua.h)), 0)) {


