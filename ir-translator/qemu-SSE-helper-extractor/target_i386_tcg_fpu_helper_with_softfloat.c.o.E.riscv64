static inline void cpu_x86_load_seg_cache(CPUX86State *env,
                                          X86Seg seg_reg, unsigned int selector,
                                          target_ulong base,
                                          unsigned int limit,
                                          unsigned int flags)
{
    SegmentCache *sc;
    unsigned int new_hflags;

    if (seg_reg == R_LDTR) {
        sc = &env->ldt;
    } else if (seg_reg == R_TR) {
        sc = &env->tr;
    } else {
        sc = &env->segs[seg_reg];
    }

    sc->selector = selector;
    sc->base = base;
    sc->limit = limit;
    sc->flags = flags;


    {
        if (seg_reg == R_CS) {

            if ((env->hflags & (1 << 14)) && (flags & (1 << 21))) {

                env->hflags |= (1 << 4) | (1 << 5) | (1 << 15);
                env->hflags &= ~((1 << 6));
            } else

            {

                new_hflags = (env->segs[R_CS].flags & (1 << 22))
                    >> (22 - 4);
                env->hflags = (env->hflags & ~((1 << 4) | (1 << 15))) |
                    new_hflags;
            }
        }
        if (seg_reg == R_SS) {
            int cpl = (flags >> 13) & 3;



            env->hflags = (env->hflags & ~(3 << 0)) | cpl;

            cpu_sync_bndcs_hflags(env);
        }
        new_hflags = (env->segs[R_SS].flags & (1 << 22))
            >> (22 - 5);
        if (env->hflags & (1 << 15)) {

        } else if (!(env->cr[0] & (1U << 0)) ||
                   (env->eflags & 0x00020000) ||
                   !(env->hflags & (1 << 4))) {





            new_hflags |= (1 << 6);
        } else {
            new_hflags |= ((env->segs[R_DS].base |
                            env->segs[R_ES].base |
                            env->segs[R_SS].base) != 0) <<
                6;
        }
        env->hflags = (env->hflags &
                       ~((1 << 5) | (1 << 6))) | new_hflags;
    }
}

static inline void cpu_x86_load_seg_cache_sipi(X86CPU *cpu,
                                               uint8_t sipi_vector)
{
    CPUState *cs = ((CPUState *)(cpu));
    CPUX86State *env = &cpu->env;

    env->eip = 0;
    cpu_x86_load_seg_cache(env, R_CS, sipi_vector << 8,
                           sipi_vector << 12,
                           env->segs[R_CS].limit,
                           env->segs[R_CS].flags);
    cs->halted = 0;
}

