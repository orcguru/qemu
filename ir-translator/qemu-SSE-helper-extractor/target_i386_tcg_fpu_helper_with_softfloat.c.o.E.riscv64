uint32_t helper_movmskps_ymm(CPUX86State *env, ZMMReg *s)
{
    uint32_t mask;
    int i;

    mask = 0;
    for (i = 0; i < 2 << 2; i++) {
        mask |= (s->_l_ZMMReg[i] >> (31 - i)) & (1 << i);
    }
    return mask;
}

uint32_t helper_movmskpd_ymm(CPUX86State *env, ZMMReg *s)
{
    uint32_t mask;
    int i;

    mask = 0;
    for (i = 0; i < 1 << 2; i++) {
        mask |= (s->_q_ZMMReg[i] >> (63 - i)) & (1 << i);
    }
    return mask;
}
