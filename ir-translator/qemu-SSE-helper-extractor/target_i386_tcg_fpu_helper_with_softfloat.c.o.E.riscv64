static inline _Bool float16_is_any_nan(float16 a)
{
    return (((a) & ~0x8000) > 0x7c00);
}

static inline _Bool float16_is_neg(float16 a)
{
    return (a) >> 15;
}

static inline _Bool float16_is_infinity(float16 a)
{
    return ((a) & 0x7fff) == 0x7c00;
}

static inline _Bool float16_is_zero(float16 a)
{
    return ((a) & 0x7fff) == 0;
}

